<project name="mps" default="build">
  <property name="idea_home" location=".."/>
  <property name="resources" location="${basedir}/resources"/>

  <target name="platform">
    <ant antfile="getDependencies.xml" target="install" inheritAll="true" useNativeBasedir="true">
      <property name="prepare.overlay" value="true"/>
    </ant>
  </target>

  <target name="getOpenjdkWin">
    <ant antfile="getResources.xml" inheritall="true" usenativebasedir="true" target="getOpenjdkWin" />
  </target>

  <target name="getOpenjdkMacM1">
    <ant antfile="getResources.xml" inheritall="true" usenativebasedir="true" target="getOpenjdkMacM1" />
  </target>

  <target name="getOpenjdkLinux">
    <ant antfile="getResources.xml" inheritall="true" usenativebasedir="true" target="getOpenjdkLinux" />
  </target>

  <target name="getOpenjdkLinuxArm">
    <ant antfile="getResources.xml" inheritall="true" usenativebasedir="true" target="getOpenjdkLinuxArm" />
  </target>

  <target name="getResourcesAndBuildAll" depends="getOpenjdkWin,getOpenjdkMacM1,getOpenjdkLinux,getOpenjdkLinuxArm">
    <ant antfile="mpsDistribution.xml" inheritAll="true" useNativeBasedir="true" target="buildDependents"/>
  </target>

  <target name="prepareJbrArchives">
    <gunzip src="${resources}/openJDK/jbr-linux-x64.tar.gz" dest="${resources}/openJDK/jbr-linux-x64.tar"/>
    <gunzip src="${resources}/openJDK/jbr-windows-x64.tar.gz" dest="${resources}/openJDK/jbr-windows-x64.tar"/>
    <gunzip src="${resources}/openJDK/jbr-linux-aarch64.tar.gz" dest="${resources}/openJDK/jbr-linux-aarch64.tar"/>
    <gunzip src="${resources}/openJDK/jbr-osx-aarch64.tar.gz" dest="${resources}/openJDK/jbr-osx-aarch64.tar"/>
  </target>

  <target name="assemble" depends="prepareJbrArchives">
    <ant antfile="mpsDistribution.xml" inheritAll="true" useNativeBasedir="true" target="assemble"/>
    <ant antfile="mpsDistribution.xml" inheritAll="true" useNativeBasedir="true" target="publishTCArtifacts"/>
    <ant antfile="mpsMaven.xml" inheritAll="true" useNativeBasedir="true" target="assemble"/>
    <ant antfile="mpsMaven.xml" inheritAll="true" useNativeBasedir="true" target="publishTCArtifact"/>
  </target>

  <target name="base" depends="platform, getResourcesAndBuildAll, assemble">
  </target>

  <target name="build" depends="platform, base"/>

  <target name="exe" depends="base">
    <property name="build.distribution" value="${basedir}/artifacts/mpsDistribution"/>
    <ant antfile="buildExe.xml" inheritAll="true" useNativeBasedir="true"/>
  </target>

  <target name="clean">
    <delete dir="tmp"/>
    <delete dir="artifacts"/>
  </target>

  <target name="cleanResources">
    <delete dir="${resources}/openJDK"/>
  </target>
</project>
