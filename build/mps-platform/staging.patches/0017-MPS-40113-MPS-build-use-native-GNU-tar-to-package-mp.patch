From: Fedor Isakov <fedor.isakov@jetbrains.com>
Date: Tue, 8 Sep 2026 12:17:53 +0200
Subject: [PATCH 17/17] MPS-40113 MPS build: use native GNU tar to package
 mps-platform-provided.tar.gz

---
 community/mps/build/build/build.xml | 128 +++++++++++++++++++++++-----
 1 file changed, 106 insertions(+), 22 deletions(-)

diff --git a/community/mps/build/build/build.xml b/community/mps/build/build/build.xml
index f9f13bbf95ade..6b1ac06ffe477 100644
--- a/community/mps/build/build/build.xml
+++ b/community/mps/build/build/build.xml
@@ -27,6 +27,30 @@
       </exec>
     </sequential>
   </macrodef>
+  
+  <macrodef name="native-tar">
+    <attribute name="destfile"/>
+    <attribute name="basedir" default="${basedir}"/>
+    <attribute name="executable" default="tar"/>
+
+    <!-- Accepts nested <arg> elements -->
+    <element name="entries" implicit="true"/>
+
+    <sequential>
+      <exec executable="@{executable}" failonerror="true">
+        <!-- -czf creates a gzip-compressed tar; use -cf for plain TAR -->
+        <arg value="-czf"/>
+        <arg file="@{destfile}"/>
+
+        <!-- Relative entries are resolved from this directory -->
+        <arg value="-C"/>
+        <arg file="@{basedir}"/>
+
+        <entries/>
+      </exec>
+    </sequential>
+  </macrodef>
+
 
   <!-- Build the IJ platform for MPS without custom patches (re-runnable) -->
   <target name="build" depends="ij-platform,repackage,package-mps-platform-provided"/>
@@ -105,30 +129,90 @@
   </target>
 
   <target name="package-mps-platform-provided">
+
+    <exec executable="tar"
+          failonerror="false"
+          failifexecutionfails="false"
+          outputproperty="tar.version"
+          errorproperty="tar.version.error"
+          resultproperty="tar.version.exit">
+      <arg value="--version"/>
+    </exec>
+
+    <condition property="tar.is.gnu">
+      <and>
+        <equals arg1="${tar.version.exit}" arg2="0"/>
+        <or>
+          <contains string="${tar.version}" substring="GNU tar"/>
+          <contains string="${tar.version.error}" substring="GNU tar"/>
+        </or>
+      </and>
+    </condition>
+
+    <fail unless="tar.is.gnu">
+      GNU tar is required; found: ${tar.version}
+    </fail>
+
