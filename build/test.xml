  <target name="default" depends="check-project-structure, module-tests"/>

  <target name="migrateSamplesAndTests" depends="unpack" description="PROVISIONAL, fix noPendingMigrationTest when there's a new migration">
    <!-- FIXME not related to test.xml, placed here as I need unpack functionality to use MPS.zip; shall refactor -->
