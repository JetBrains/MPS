<project name="test" default="default" basedir="../">
  <property name="build.dir" location="build"/>
  <property name="build.tmp" location="${build.dir}/tmp/tests"/>
  <property name="build.distribution" location="${build.dir}/artifacts/mpsDistribution"/>
  <loadproperties srcfile="${build.distribution}/build.properties"/>
  <property name="mps.zip" location="${build.distribution}/${mps.build.number}.zip"/>
  <property name="mps_build_home" location="${build.tmp}/MPS ${mpsBootstrapCore.version}"/>
  <property name="env.JAVA_HOME" value="${java.home}/.." />
  <property name="jdk.home" value="${env.JAVA_HOME}" />

  <target name="unpack">
    <unzip src="${mps.zip}" dest="${build.tmp}"/>
    <copy todir="${mps_build_home}/lib/jna">
      <fileset dir="${mps_build_home}/lib/jna/amd64" includes="*.*"/>
    </copy>
  </target>

  <target name="check-project-structure" depends="unpack">
    <junit fork="true" dir="${mps_build_home}" showoutput="true">
      <jvmarg value="-ea"/>
      <jvmarg value="-Dmps.junit.modules.root=."/>
      <jvmarg value="-Xss1024k"/>
      <jvmarg value="-Xmx1200m"/>
      <jvmarg value="-XX:+HeapDumpOnOutOfMemoryError"/>
      <test name="jetbrains.mps.testbench.junit.suites.CheckProjectStructure"/>
      <formatter type="xml"/>
      <classpath>
        <!-- vendored kotlin-metadata must shadow the platform's shrunk intellij.libraries.kotlin.metadata.jar -->
        <fileset dir="${mps_build_home}/lib">
          <include name="kotlin-metadata-jvm-*.jar"/>
          <include name="kotlinx-metadata-klib-*.jar"/>
        </fileset>
        <fileset dir="${mps_build_home}/lib">
          <include name="*.jar"/>
        </fileset>
      </classpath>
    </junit>
  </target>

  <target name="module-tests" depends="unpack">
    <ant antfile="build/tests/mpsVCS_alt.xml" inheritAll="true" useNativeBasedir="true">
      <target name="run-mps-code"/>
      <property name="mps_home" value="${mps_build_home}"/>
      <property name="idea_home" value="${mps_build_home}"/>
    </ant>
    <ant antfile="build/tests/mpsBehavior.xml" inheritAll="true" useNativeBasedir="true">
      <target name="build"/>
      <target name="check"/>
      <property name="mps_home" value="${mps_build_home}"/>
    </ant>
    <ant antfile="build/tests/mpsHttpSupport.xml" inheritAll="true" useNativeBasedir="true">
      <target name="build"/>
      <target name="check"/>
      <property name="mps_home" value="${mps_build_home}"/>
    </ant>
