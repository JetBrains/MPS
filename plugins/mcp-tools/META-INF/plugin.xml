<idea-plugin>
  <id>jetbrains.mps.agents.mcp.tools</id>
  <name>Projectional Agent Toolkit</name>
  <description><![CDATA[
    <p>Gives AI coding agents access to JetBrains MPS through MCP tools: they can navigate, query, edit,
    validate, and generate MPS models and languages in the open project.</p>
    <p>This is the same plugin that comes bundled with MPS, published separately so that it can be
    updated more frequently than MPS itself.</p>
  ]]></description>
  <vendor url="http://www.jetbrains.com/mps/">JetBrains</vendor>
  <!-- Bundled copy omits <version> so MPS assigns its build number; mpsMcpToolsDistribution stamps <version> here for the standalone zip. -->
  <!-- @plugin.version@ -->
  <idea-version since-build="261.1" until-build="262.1"/>

  <depends>com.intellij.mcpServer</depends>
  <depends>jetbrains.mps.core</depends>
  <depends>com.intellij.modules.mps</depends>
  <depends>jetbrains.mps.ide.java</depends>
  <depends>jetbrains.mps.ide.migration.workbench</depends>

  <extensions defaultExtensionNs="com.intellij">
    <mcpServer.mcpToolset implementation="jetbrains.mps.agents.mcp.tools.MPSProjectMcpToolset" />
    <mcpServer.mcpToolset implementation="jetbrains.mps.agents.mcp.tools.MPSConsoleMcpToolset" />
    <mcpServer.mcpToolset implementation="jetbrains.mps.agents.mcp.tools.MPSLanguageMcpToolset" />
    <mcpServer.mcpToolset implementation="jetbrains.mps.agents.mcp.tools.MPSModuleMcpToolset" />
    <mcpServer.mcpToolset implementation="jetbrains.mps.agents.mcp.tools.MPSModelMcpToolset" />
    <mcpServer.mcpToolset implementation="jetbrains.mps.agents.mcp.tools.MPSRootNodeMcpToolset" />
    <mcpServer.mcpToolset implementation="jetbrains.mps.agents.mcp.tools.MPSNodeMcpToolset" />
    <mcpServer.mcpToolset implementation="jetbrains.mps.agents.mcp.tools.MPSTypesMcpToolset" />
    <mcpServer.mcpToolset implementation="jetbrains.mps.agents.mcp.tools.MPSDataflowMcpToolset" />
    <mcpServer.mcpToolset implementation="jetbrains.mps.agents.mcp.tools.MPSIntentionsMcpToolset" />
    <mcpServer.mcpToolset implementation="jetbrains.mps.agents.mcp.tools.MPSEditorMcpToolset" />
    <mcpServer.mcpToolset implementation="jetbrains.mps.agents.mcp.tools.MPSLanguageStructureMcpToolset" />
    <mcpServer.mcpToolset implementation="jetbrains.mps.agents.mcp.tools.MPSJavaMcpToolset" />
    <mcpServer.mcpToolset implementation="jetbrains.mps.agents.mcp.tools.MPSRunConfigurationMcpToolset" />
    <mcpServer.mcpToolset implementation="jetbrains.mps.agents.mcp.tools.MPSMigrationMcpToolset" />
    <mcpServer.mcpToolset implementation="jetbrains.mps.agents.mcp.tools.MPSGenerationMcpToolset" />
    <mcpServer.mcpToolset implementation="jetbrains.mps.agents.mcp.tools.MPSInitMcpToolset" />
  </extensions>
  <applicationListeners>
    <!-- Optional per-call JSON-lines log; active only with -Dmps.mcp.calllog=<file>. -->
    <listener class="jetbrains.mps.agents.mcp.tools.logging.McpCallLogListener" topic="com.intellij.mcpserver.ToolCallListener" />
    <!-- Suppresses the Migration Assistant auto-start in a project once an agent calls an mps_mcp_* tool (D48). -->
    <listener class="jetbrains.mps.agents.mcp.tools.migration.MigrationAssistantGuard" topic="com.intellij.mcpserver.ToolCallListener" />
  </applicationListeners>
</idea-plugin>
