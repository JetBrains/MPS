{"ok":true,"data":"\npublic class CompactViewTestUtil { \n   \n  public static final String COMPACT_HINT = \"mcp.study.alerts.editor.AlertHints.compact\"; \n   \n  public static void pushHints(final EditorComponent ec, final String[] hints) throws Exception { \n    SwingUtilities.invokeAndWait(new Runnable() { \n      public void run()  { \n        if (ec.getUpdater().setInitialEditorHints(hints)) { \n          ec.getEditorContext().getRepository().getModelAccess().runReadAction(new Runnable() { \n            public void run()  { \n              ec.rebuildEditorContent(); \n            } \n          }); \n        } \n        ec.getEditorContext().flushEvents(); \n      } \n    }); \n  } \n   \n  public static void pushCompact(final EditorComponent ec) throws Exception { \n    pushHints(ec, new String[]{COMPACT_HINT}); \n  } \n   \n  public static List<String> memberLabels(final EditorComponent ec, final String memberName) throws Exception { \n    final List<List<String>> out = new  ArrayList<List<String>>(); \n    SwingUtilities.invokeAndWait(new Runnable() { \n      public void run()  { \n        ec.getEditorContext().getRepository().getModelAccess().runReadAction(new Runnable() { \n          public void run()  { \n            out.add(labels(ec, member(ec, memberName))); \n          } \n        }); \n      } \n    }); \n    return out.get(0); \n  } \n   \n  public static boolean isChildShown(final EditorComponent ec, fin
