<project name="buildMpsT" default="build" basedir="../..">
  <!-- Generated by MPS -->
  <property name="build.dir" location="build" />
  <property name="build.tmp" location="${build.dir}/tmp/buildMpsT" />
  <property name="build.layout" location="${build.dir}/artifacts/buildMpsT" />
  <property name="artifacts.TarsFromT" location="${basedir}/jetbrains.mps.build.sandbox/samples" />
  
  <target name="assemble" depends="fetchDependencies">
    <mkdir dir="${build.layout}" />
    <tar destfile="${build.layout}/plain-folder.tar" longfile="gnu">
      <tarfileset src="${artifacts.TarsFromT}/tarSource.tar" prefix="repacked">
        <include name="lib/**" />
      </tarfileset>
    </tar>
    <tar destfile="${build.layout}/gzip-folder.tar.gz" compression="gzip" longfile="gnu">
      <tarfileset src="${basedir}/jetbrains.mps.build.sandbox/samples/tarSource.tar" prefix="repacked">
        <include name="lib/**" />
        <exclude name="**/*.txt" />
      </tarfileset>
    </tar>
    <tar destfile="${build.layout}/plain-direct.tar" longfile="gnu">
      <tarfileset src="${basedir}/jetbrains.mps.build.sandbox/samples/tarSource.tar" />
    </tar>
    <tar destfile="${build.layout}/gzip-direct.tar.gz" compression="gzip" longfile="gnu">
      <tarfileset src="${artifacts.TarsFromT}/tarSource.tar">
        <include name="lib/**" />
      </tarfileset>
    </tar>
  </target>
  
  <target name="buildDependents" />
  
  <target name="fetchDependencies" />
  
  <target name="build" depends="assemble" />
  
  <target name="clean">
    <delete dir="${build.tmp}" />
    <delete dir="${build.layout}" />
  </target>
</project>