<!DOCTYPE idea-plugin PUBLIC "Plugin/DTD" "http://plugins.intellij.net/plugin.dtd">
<idea-plugin>
  <id>jetbrains.mps.ide.devkit</id>
  <name>MPS Languages DevKit</name>
  <description>Plugin intended for Language Designers. Facilitates developing new MPS languages</description>
  <category>Custom Languages</category>
  <version>2026.2</version>
  <vendor url="http://www.jetbrains.com/mps/" email="support@jetbrains.com">JetBrains</vendor>
  <idea-version since-build="262.1" until-build="262.*"/>
  <dependencies>
    <plugin id="jetbrains.mps.core"/>
    <module name="intellij.spellchecker"/>
    <!-- Necessary dependency to be able to override actions from the module  -->
    <module name="intellij.xml.impl"/>
  </dependencies>
  <depends>jetbrains.mps.ide.make</depends>
  <depends>jetbrains.mps.testing</depends>
  <depends>jetbrains.mps.ide.modelchecker</depends>

  <extensions defaultExtensionNs="com.intellij">
    <errorHandler implementation="jetbrains.mps.ide.blame.CharismaReporter" />
    <spellchecker.bundledDictionaryProvider implementation="jetbrains.mps.spellchecker.MPSBundledDictionariesProvider"/>
    <toolWindow factoryClass="jetbrains.mps.plugins.tool.MpsToolWindowFactory"
                id="Typesystem Trace" anchor="right" secondary="false" canCloseContents="false"
                icon="jetbrains.mps.icons.MPSIcons.ToolWindows.TypeTraceView"/>
    <toolWindow factoryClass="jetbrains.mps.plugins.tool.MpsToolWindowFactory"
                id="Generation Tracer" anchor="bottom" secondary="false" canCloseContents="true"
                icon="jetbrains.mps.ide.icons.IdeIcons.DEFAULT_ICON"/>
    <toolWindow factoryClass="jetbrains.mps.plugins.tool.MpsToolWindowFactory"
                id="Menu Trace" anchor="bottom" secondary="false" canCloseContents="true"
                icon="jetbrains.mps.icons.MPSIcons.ToolWindows.Default"/>
    <toolWindow factoryClass="jetbrains.mps.plugins.tool.MpsToolWindowFactory"
                id="Cell Explorer" anchor="bottom" secondary="false" canCloseContents="true"
                icon="jetbrains.mps.icons.MPSIcons.ToolWindows.CellExplorer"/>
    <toolWindow factoryClass="jetbrains.mps.plugins.tool.MpsToolWindowFactory"
                id="Node Explorer" anchor="bottom" secondary="false" canCloseContents="true"/>
    <toolWindow factoryClass="jetbrains.mps.plugins.tool.MpsToolWindowFactory"
                id="Dependencies Viewer" anchor="bottom" secondary="false" canCloseContents="false"
                icon="jetbrains.mps.icons.MPSIcons.ToolWindows.DependencyAnalyzer"/>
    <toolWindow factoryClass="jetbrains.mps.plugins.tool.MpsToolWindowFactory"
                id="Module Dependencies" anchor="bottom" secondary="false" canCloseContents="false"
                icon="AllIcons.Toolwindows.ToolWindowModuleDependencies"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <mps.LanguageLibrary dir="languages/" hide="true"/>
    <mps.VisibleModuleMask mask="jetbrains\.mps\.analyzers.*"/>
    <mps.VisibleModuleMask mask="jetbrains\.mps\.build.*"/>
    <mps.VisibleModuleMask mask="jetbrains\.mps\.dataFlow\.runtime"/>
    <mps.VisibleModuleMask mask="jetbrains\.mps\.devkit\.bootstrap-languages"/>
    <mps.VisibleModuleMask mask="jetbrains\.mps\.devkit\.language-design"/>
    <mps.VisibleModuleMask mask="jetbrains\.mps\.devkit\.aspect\..*"/>
    <mps.VisibleModuleMask mask="jetbrains\.mps\.devkit\.templates"/>
    <mps.VisibleModuleMask mask="jetbrains\.mps\.editor\.runtime"/>
    <mps.VisibleModuleMask mask="jetbrains\.mps\.execution\..*"/>
    <mps.VisibleModuleMask mask="jetbrains\.mps\.findUsages.*"/>
    <mps.VisibleModuleMask mask="jetbrains\.mps\.generator"/>
    <mps.VisibleModuleMask mask="jetbrains\.mps\.ide.*"/>
    <mps.VisibleModuleMask mask="jetbrains\.mps\.kernel"/>
    <mps.VisibleModuleMask mask="jetbrains\.mps\.lang.*"/>
    <mps.VisibleModuleMask mask="jetbrains\.mps\.make.*"/>
    <mps.VisibleModuleMask mask="jetbrains\.mps\.migration\.component"/>
    <mps.VisibleModuleMask mask="jetbrains\.mps\.core\.xml.*"/>
    <mps.VisibleModuleMask mask="jetbrains\.mps\.refactoring\.runtime"/>
    <mps.VisibleModuleMask mask="jetbrains\.mps\.runtime"/>
    <mps.VisibleModuleMask mask="jetbrains\.mps\.smodel\.resources"/>
    <mps.VisibleModuleMask mask="jetbrains\.mps\.traceInfo.*"/>
    <mps.VisibleModuleMask mask="jetbrains\.mps\.typechecking.*"/>
    <mps.VisibleModuleMask mask="jetbrains\.mps\.typesystemEngine"/>
    <mps.VisibleModuleMask mask="MPS.*"/>
    <mps.VisibleModuleMask mask="stubUtils"/>
    <mps.VisibleModuleMask mask="Testbench"/>
    <mps.VisibleModuleMask mask="typesystemIntegration"/>
    <mps.VisibleModuleMask mask="jetbrains\.mps\.kotlin.*"/>
    <mps.VisibleModuleMask mask="jetbrains\.mps\.baseLanguage\.kotlinRefs.*"/>
    <mps.IntentionActionsProvider implementation="jetbrains.mps.ide.devkit.editor.IntentionActionsProviderImpl" />
    <mps.projectGroupTemplateEP implementation="jetbrains.mps.workbench.dialogs.project.newproject.LanguageProjectsGroup"/>
    <mps.languageProjectTemplateEP implementation="jetbrains.mps.workbench.dialogs.project.newproject.DefaultLanguageProjectTemplate"/>
  </extensions>
  <actions>

    <!-- Former content of DisabledXmlPluginActions.xml -->
    <group id="ToolsXmlGroup" class="com.intellij.openapi.actionSystem.EmptyActionGroup" overrides="true"/>
    <action id="EscapeEntities" class="com.intellij.openapi.actionSystem.EmptyAction" overrides="true"/>
    <action id="EmmetNextEditPoint" class="com.intellij.openapi.actionSystem.EmptyAction" overrides="true"/>
    <action id="EmmetPreviousEditPoint" class="com.intellij.openapi.actionSystem.EmptyAction" overrides="true"/>

    <!--  Insert MPS actions between IntelliJ Help group actions  -->
    <!--Help-->
    <group>
      <action id="ShowHomepage"
              class="jetbrains.mps.ide.devkit.help.ShowHomepageAction"
              text="Homepage"/>
      <add-to-group group-id="HelpMenu" relative-to-action="OnlineDocAction" anchor="before"/>
    </group>
    <!--Getting Started-->
    <group>
      <action id="ShowStepikCourse"
              class="jetbrains.mps.ide.devkit.help.ShowStepikCourseAction"
              text="Quickstart course"/>
      <action id="ShowUserGuide"
              class="jetbrains.mps.ide.devkit.help.ShowUserGuideAction"
              text="User Guide"/>
      <add-to-group group-id="HelpMenu" relative-to-action="OnlineDocAction" anchor="after"/>
    </group>
    <!--Keymap Reference-->
    <!--Demos and Screencasts-->
    <!--Tip of the Day-->
    <!--What’s New in JetBrains MPS-->
    <group id="MPSHelpMenu">
      <action id="ShowMPSBlogAction"
              class="jetbrains.mps.ide.devkit.help.ShowBlogAction"
              text="Blog"/>
      <action id="ShowCommunitySite"
              class="jetbrains.mps.ide.devkit.help.ShowCommunitySiteAction"
              text="Slack Community"/>
      <action id="ShowFAQ"
              class="jetbrains.mps.ide.devkit.help.ShowFAQAction"
              text="FAQ"/>
      <separator/>
      <add-to-group group-id="HelpMenu" relative-to-action="WhatsNewAction" anchor="after"/>
    </group>

    <!--  Override IntelliJ Help and Resources group actions in Learn IDE tab on Welcome Screen,
    re-enter the original actions without the in-IDE WhatsNewAction, add MPS actions to the end
     and the in-browser What's new action to the front -->
    <group id="WelcomeScreen.LearnIdeHelp" keep-content="false" overrides="true">
      <action id="WhatsNewActionInBrowser" class="com.intellij.ide.actions.WhatsNewAction"/>
      <reference ref="HelpTopics"/>
      <reference ref="OnlineDocAction"/>
      <reference ref="Help.JetBrainsTV"/>
      <reference ref="Help.KeymapReference"/>
      <separator/>
      <reference ref="ShowUserGuide"/>
      <reference ref="ShowStepikCourse"/>
      <reference ref="ShowCommunitySite"/>
      <reference ref="ShowFAQ"/>
    </group>
  </actions>


</idea-plugin>
