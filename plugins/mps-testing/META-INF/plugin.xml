<idea-plugin>
  <id>jetbrains.mps.testing</id>
  <name>MPS Testing</name>
  <category>Custom Languages</category>
  <description>Languages unit-testing java code and MPS aspects such as editor and typesystem</description>
  <version>2026.1.1</version>
  <vendor url="http://www.jetbrains.com/mps/" email="support@jetbrains.com">JetBrains</vendor>
  <idea-version since-build="261.1" until-build="262.1"/>
  <dependencies>
    <plugin id="jetbrains.mps.core"/>
  </dependencies>

  <depends>jetbrains.mps.core</depends>
  <depends optional="true">jetbrains.mps.ide</depends> <!-- FIXME 'optional' is a provisional workaround -->
  <depends>jetbrains.mps.junit5</depends>
  <depends>com.intellij.modules.lang</depends>

  <extensions defaultExtensionNs="com.intellij">
    <mps.LanguageLibrary dir="/" hide="true"/>
    <errorHandler implementation="jetbrains.mps.ide.blame.CharismaReporter"/>
  </extensions>
</idea-plugin>
