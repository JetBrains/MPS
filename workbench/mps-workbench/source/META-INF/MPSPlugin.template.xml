<!--    <projectService serviceImplementation="com.intellij.platform.whatsNew.WhatsNewMultipageStartIdProvider" open="true"/>-->
<!--    <statistics.counterUsagesCollector implementationClass="com.intellij.platform.whatsNew.reaction.ReactionCollector"/>-->
<!--    <statistics.counterUsagesCollector implementationClass="com.intellij.platform.whatsNew.collectors.WhatsNewCounterUsageCollector"/>-->
<!--    <statistics.validation.customValidationRule implementation="com.intellij.platform.whatsNew.collectors.WhatsNewMultipageIdValidationRule"/>-->

<!--    <registryKey defaultValue="false" description="Whats new test mode" key="whats.new.test.mode" restartRequired="false" />-->
<!--    <registryKey key="csat.survey.enabled" defaultValue="false" description="Enables periodic CSAT survey" overrides="true"/>-->
