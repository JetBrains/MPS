<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
  <id>com.intellij</id>
  <name>IDEA CORE</name>

  @@MODULE_DESCRIPTORS@@

  <module value="com.intellij.modules.mps"/>
  <module value="com.intellij.modules.all"/>
  <module value="com.intellij.modules.xml"/>

  <xi:include href="/META-INF/IdeTipsAndTricks.xml"/>
  <xi:include href="/META-INF/PlatformLangPlugin.xml"/>

  <xi:include href="intellij.json.xml">
    <xi:fallback/>
  </xi:include>
  <xi:include href="/META-INF/SpellCheckerPlugin.xml">
    <xi:fallback/>
  </xi:include>
  <projectListeners>
    <listener class="jetbrains.mps.intellij.integration.DisablingPlatformToolWindowsListener"
              topic="com.intellij.openapi.wm.ex.ToolWindowManagerListener"/>
  </projectListeners>
  <!-- Customizations to platform -->
  <xi:include href="/META-INF/DisabledPlatformActions.xml"/>
  <xi:include href="/META-INF/DisabledLangActions.xml"/>
  <actions>
    <!-- File -->
    <!-- Intentionally using a different ID for standard NewElement action -->
    <!-- The standard NewElement ID is used for MPS-specific action that delegates to this one -->
    <!-- See NewElement action in jetbrains.mps.ide.actions model -->
    <action id="NewElementFile" class="com.intellij.ide.actions.NewElementAction"/>
<!--    <group id="OpenProjectGroup">-->
<!--      <group id="NewElementInMenuGroup" class="com.intellij.ide.actions.NewActionGroup" text="New" popup="true"/>-->
<!--      <add-to-group group-id="FileOpenGroup" anchor="first"/>-->
<!--    </group>-->
    <group id="MPSNewProjectOrModuleGroup">
      <action id="NewProject" class="jetbrains.mps.workbench.actions.NewMPSProjectAction" text="New MPS Project">
        <override-text place="ProjectWidgetPopup" text="New Project..."/>
        <add-to-group group-id="ProjectWidget.Actions" anchor="first"/>
      </action>
      <add-to-group group-id="NewProjectOrModuleGroup"/>
    </group>

    <!-- *** moved to MPSVcs.xml as here it doesn't work *** -->
    <!--action id="ProjectFromVersionControl" class="com.intellij.openapi.wm.impl.welcomeScreen.ProjectFromVersionControlAction" text="Checkout from Version Control">
      <override-text place="ProjectWidgetPopup" text="Get from Version Control..."/>
      <add-to-group group-id="NewProjectOrModuleGroup" relative-to-action="NewProject" anchor="after"/>
      <add-to-group group-id="ProjectWidget.Actions" relative-to-action="OpenProjectGroup" anchor="after"/>
    </action-->

    <action id="ForceSaveAll" class="jetbrains.mps.ide.actions.ForceSaveAll_Action">
      <add-to-group group-id="FileMenu" relative-to-action="SaveAll" anchor="after"/>
    </action>
    <action id="SaveAsNewFormat" class="com.intellij.ide.actions.SaveAsDirectoryBasedFormatAction" text="Save as Directory-Based Format...">
      <add-to-group group-id="ExportImportGroup" anchor="last"/>
    </action>

    <!--Start of analog of groups changes from JavaActions.xml-->
    <!-- Analyze -->
    <group overrides="true" class="com.intellij.openapi.actionSystem.EmptyActionGroup" id="AnalyzePlatformMenu"/>
    <group overrides="true" class="com.intellij.openapi.actionSystem.EmptyActionGroup" id="InspectCodeInCodeMenuGroup"/>
    <group overrides="true" class="com.intellij.openapi.actionSystem.EmptyActionGroup" id="InspectCodeActionInPopupMenus"/>

    <group id="AnalyzeMenu" popup="true">
      <separator/>
      <reference ref="AnalyzeActions"/>
      <add-to-group group-id="MainMenu" anchor="after" relative-to-action="CodeMenu"/>
    </group>
    <!--End of analog of groups changes from JavaActions.xml-->
  </actions>

  <xi:include href="/META-INF/MPSComponents.xml"/> <!--only MPS components-->
  <xi:include href="/idea/MPSActionManager.xml"/> <!--only MPS actions-->
  <xi:include href="/jetbrains/mps/ide/platform/actions/PlatformActions.xml"/> <!--only MPS
  actions-->
  <xi:include href="/jetbrains/mps/ide/editor/actions/MPSEditorActions.xml"/> <!--only MPS editor actions-->

  <extensions defaultExtensionNs="com.intellij">
    <postStartupActivity implementation="com.intellij.platform.whatsNew.WhatsNewShowOnStartCheckService" order="last"/>
    <applicationService serviceImplementation="com.intellij.platform.whatsNew.WhatsNewInVisionContentProvider" open="true"/>
    <projectService serviceImplementation="com.intellij.platform.whatsNew.WhatsNewMultipageStartIdProvider" open="true"/>
    <statistics.counterUsagesCollector implementationClass="com.intellij.platform.whatsNew.reaction.ReactionCollector"/>
    <statistics.counterUsagesCollector implementationClass="com.intellij.platform.whatsNew.collectors.WhatsNewCounterUsageCollector"/>
    <statistics.validation.customValidationRule implementation="com.intellij.platform.whatsNew.collectors.WhatsNewMultipageIdValidationRule"/>

    <applicationService serviceInterface="com.intellij.platform.ide.customization.ExternalProductResourceUrls"
                        serviceImplementation="jetbrains.mps.intellij.integration.MPSExternalResourceUrls"
                        overrides="true"/>

    <registryKey defaultValue="false" description="Whats new test mode" key="whats.new.test.mode" restartRequired="false" />
    <registryKey key="csat.survey.enabled" defaultValue="false" description="Enables periodic CSAT survey" overrides="true"/>
  </extensions>
  <actions resource-bundle="messages.ActionsBundle">
    <action id="WhatsNewAction" class="com.intellij.platform.whatsNew.WhatsNewAction" overrides="true"/>
  </actions>

  <extensions defaultExtensionNs="com.intellij">
    <errorHandler implementation="jetbrains.mps.ide.blame.CharismaReporter"/>
    <!-- The only reason this contribution is here is that it replaces Ide_PluginInitializer app component that used to be registered here -->
    <mps.PluginComponentContributor application="jetbrains.mps.ide.actions.Ide_ApplicationPlugin" project="jetbrains.mps.ide.actions.Ide_ProjectPlugin" />
    <!-- MPS Patch: need to be loaded before LafManagerImpl service -->
    <applicationService serviceImplementation="jetbrains.mps.intellij.integration.LafFixer" preload="true" order="before com.intellij.ide.ui.LafManager"/>
  </extensions>

  <extensionPoints>
    <extensionPoint name="mps.CodeNavigationProvider" interface="jetbrains.mps.ide.navigation.CodeNavigationProvider"/>
    <extensionPoint name="mps.ModelValidator" interface="jetbrains.mps.ide.generator.ModelValidator"/> <!-- DEPRECATED -->
    <extensionPoint name="mps.TabColorProvider" area="IDEA_PROJECT" interface="jetbrains.mps.ide.editorTabs.TabColorProvider"/>
    <extensionPoint name="mps.projectPrefsPanel" interface="jetbrains.mps.workbench.dialogs.project.properties.project.ProjectPrefsExtraPanel"
                    area="IDEA_PROJECT"/>
    <extensionPoint name="mps.projectGroupTemplateEP" interface="jetbrains.mps.workbench.dialogs.project.newproject.ProjectTemplatesGroup" dynamic="true"/>
    <extensionPoint name="mps.languageProjectTemplateEP" interface="jetbrains.mps.workbench.dialogs.project.newproject.LanguageProjectTemplate" dynamic="true"/>
    <extensionPoint name="mps.solutionProjectTemplateEP" interface="jetbrains.mps.workbench.dialogs.project.newproject.SolutionProjectTemplate" dynamic="true"/>
    <extensionPoint name="mps.otherProjectTemplateEP" interface="jetbrains.mps.workbench.dialogs.project.newproject.OtherProjectTemplate" dynamic="true"/>
  </extensionPoints>

  <extensions defaultExtensionNs="com.intellij">
    <applicationActivity implementation="com.intellij.internal.statistic.updater.StatisticsJobsScheduler"/>
    <applicationActivity implementation="com.intellij.internal.statistic.updater.StatisticsStateCollectorsScheduler"/>

    <projectViewPane implementation="jetbrains.mps.ide.projectPane.ProjectPane"/>
    <projectViewPane implementation="jetbrains.mps.ide.projectPane.fileSystem.FileViewProjectPane"/>

    <errorHandler implementation="jetbrains.mps.ide.blame.CharismaReporter"/>
    <analyzeStacktraceFilter implementation="jetbrains.mps.ide.actions.StandaloneMPSStackTraceFilter"/>

    <directoryIndexExcludePolicy implementation="jetbrains.mps.ide.vfs.ClassesGenPolicy"/>

    <featureStatisticsBundle qualifiedName="messages.MPSFeatureStatisticsBundle"/>

    <!-- MPS patch: allows show custom info when no editors opened-->
    <applicationService serviceInterface="com.intellij.openapi.fileEditor.impl.EditorEmptyTextPainter"
                        serviceImplementation="jetbrains.mps.ide.ui.fileEditor.MPSEditorEmptyTextPainter"
                        overrides="true"/>
    <applicationService serviceInterface="com.intellij.platform.whatsNew.WhatsNewInVisionContentProvider"
                        serviceImplementation="jetbrains.mps.MPSWhatsNewInVisionContentProvider"
                        overrides="true"/>
    <!-- Similar to community/java/ide-customization/resources/META-INF/plugin.xml -->
    <!-- preload because in any case will be requested to reopen last projects -->
    <applicationService serviceInterface="com.intellij.ide.RecentProjectsManager"
                        serviceImplementation="jetbrains.mps.intellij.integration.MPSRecentProjectsManagerBase"
                        overrides="true" preload="notHeadless"/>

    <!-- Global Code Style -->
    <projectConfigurable parentId="preferences.sourceCode" displayName="MPS" instance="jetbrains.mps.ide.codeStyle.CodeStyleSettingsConfigurable" />
    <projectConfigurable groupId="build" groupWeight="110" instance="jetbrains.mps.ide.compiler.CompilerSettingsConfigurable" order="after project"
                         displayName="Java Compiler" nonDefaultProject="true"/>
    <applicationConfigurable groupId="editor" displayName="MPS Intentions"
                             instance="jetbrains.mps.intentions.IntentionSettingsConfigurable" id="preferences.intentionPowerPack2"/>

    <!--MPS patch: add two setting pages-->
    <projectConfigurable groupId="build" groupWeight="130" instance="jetbrains.mps.library.ProjectLibraryManagerConfigurable"
                         id="preferences.projectLibraryManager" displayName="Project Libraries" nonDefaultProject="true"/>
    <applicationConfigurable groupId="build" groupWeight="120" instance="jetbrains.mps.library.LibraryManagerConfigurable"
                             id="preferences.libraryManager" displayName="Global Libraries"/>

    <!-- allow mps to open mpr projects from command line -->
    <projectOpenProcessor implementation="jetbrains.mps.ide.project.MpsProjectOpenProcessor"/>

    <moduleRendererFactory implementation="com.intellij.ide.util.PlatformModuleRendererFactory" order="last" id="platform"/>

    <!--For run config creation with action-->
    <getDataRule key="Location"
                 implementationClass="jetbrains.mps.workbench.dataExtraction.runConfig.LocationRule" type="context"/>

    <editorTabTitleProvider implementation="jetbrains.mps.ide.editor.tabs.EditorTabTitleProviderImpl"/>

<!--    FIXME enable favorites view-->
<!--    <favoriteNodeProvider implementation="jetbrains.mps.ide.projectPane.favorites.providers.MPSFavoriteNodeProvider"/>-->
<!--    <favoriteNodeProvider implementation="jetbrains.mps.ide.projectPane.favorites.providers.MPSFavoriteReferenceProvider"/>-->
<!--    <favoriteNodeProvider implementation="jetbrains.mps.ide.projectPane.favorites.providers.MPSFavoriteModelProvider"/>-->
<!--    <favoriteNodeProvider implementation="jetbrains.mps.ide.projectPane.favorites.providers.MPSFavoriteModuleProvider"/>-->
<!--    <favoriteNodeProvider implementation="jetbrains.mps.ide.projectPane.favorites.providers.MPSFavoritePropertyProvider"/>-->

    <!-- Seems like we should set platform prefix different from IDEA/community so this scope will not be necessary anymore -->
    <customScopesProvider implementation="com.intellij.packageDependencies.TestScopeProvider"/>

    <fileBasedIndex implementation="jetbrains.mps.ide.generator.index.ModelDigestIndex"/>
    <fileBasedIndex implementation="jetbrains.mps.ide.generator.index.BinaryModelDigestIndex"/>
    <indexedRootsProvider implementation="jetbrains.mps.ide.findusages.caches.MPSIndexableSetContributor"/>

    <syntaxHighlighter key="JAVA" implementationClass="jetbrains.mps.ide.java.JavaFileHighlighter"/>
    <syntaxHighlighter key="XML" implementationClass="com.intellij.ide.highlighter.XmlFileHighlighter"/>
    <syntaxHighlighter key="Model" implementationClass="com.intellij.ide.highlighter.XmlFileHighlighter"/>
    <syntaxHighlighter key="Solution" implementationClass="com.intellij.ide.highlighter.XmlFileHighlighter"/>
    <syntaxHighlighter key="Language" implementationClass="com.intellij.ide.highlighter.XmlFileHighlighter"/>
    <syntaxHighlighter key="Devkit" implementationClass="com.intellij.ide.highlighter.XmlFileHighlighter"/>
    <syntaxHighlighter key="MPS Project" implementationClass="com.intellij.ide.highlighter.XmlFileHighlighter"/>

    <gotoFileContributor implementation="jetbrains.mps.MPSGoToFileContributor"/>

    <projectService serviceInterface="com.intellij.ide.projectView.ProjectView"
                    serviceImplementation="jetbrains.mps.ide.projectView.ProjectViewImpl"
                    overrides="true"/>
    <projectService serviceInterface="jetbrains.mps.ide.projectView.MPSProjectViewState"
                    serviceImplementation="jetbrains.mps.ide.projectView.MPSProjectViewState"/>

    <fileIconProvider implementation="jetbrains.mps.workbench.editors.MPSIconProvider"/>

    <projectService serviceImplementation="jetbrains.mps.ide.findusages.caches.IndexableRootCalculator"/>

<!--    <sdkType implementation="com.intellij.openapi.projectRoots.impl.JavaSdkImpl"/>-->
<!--    <applicationService serviceInterface="com.intellij.openapi.projectRoots.DefaultJdkConfigurator"-->
<!--                        serviceImplementation="com.intellij.openapi.projectRoots.impl.DefaultJdkConfiguratorImpl"/>-->
<!--    <orderRootType implementation="com.intellij.openapi.roots.JavadocOrderRootType"/>-->

    <dynamicActionConfigurationCustomizer  implementation="jetbrains.mps.ide.projectPane.ProjectPaneActionsCustomizer"/>
  </extensions>

  <actions>
    <!--MPS Patch to avoid collision with Duplicate Node action TODO: find way to avoid this!!!-->
    <action id="CompareTwoFiles" class="com.intellij.openapi.actionSystem.EmptyAction" overrides="true"/>
    <action id="$Cut" class="jetbrains.mps.workbench.actions.MPSCutAction" icon="AllIcons.Actions.MenuCut" overrides="true"/>
    <action id="$Copy" class="jetbrains.mps.workbench.actions.MPSCopyAction" icon="AllIcons.Actions.Copy" overrides="true"/>
    <action id="$Paste" class="jetbrains.mps.workbench.actions.MPSPasteAction" icon="AllIcons.Actions.MenuPaste" overrides="true"/>
    <group id="FileChooserToolbar.MPS">
      <action id="FileChooser.GotoMPSModule"
              class="jetbrains.mps.ide.ui.filechoosers.treefilechooser.GotoModuleDirectory"
              text="Go to Module Directory"
              icon="com.intellij.icons.AllIcons.Actions.ModuleDirectory"/>
      <add-to-group group-id="FileChooserToolbar" anchor="after" relative-to-action="FileChooser.GotoProject"/>
    </group>
    <action id="FileChooser.ShowHidden" class="com.intellij.openapi.fileChooser.actions.ToggleVisibilityAction" overrides="true"
    icon="AllIcons.Actions.ToggleVisibility"/>
    <action id="OpenFile" class="jetbrains.mps.workbench.actions.OpenMPSProjectAction" overrides="true" icon="AllIcons.Actions.MenuOpen"/>
    <action id="WelcomeScreen.OpenDirectoryProject" class="jetbrains.mps.workbench.actions.OpenMPSProjectAction$OnMPSWelcomeScreen" overrides="true"/>
  </actions>

  <actions>
    <action id="WhatsNewShowProjectView"
            class="jetbrains.mps.workbench.actions.whatsnew.WhatsNewShowProjectView">
    </action>
    <action id="WhatsNewProjectWizard"
            class="jetbrains.mps.workbench.actions.whatsnew.WhatsNewProjectWizard">
    </action>
    <action id="MPSProjectView.ShowErrorsOnly"
            class="jetbrains.mps.ide.projectView.ProjectViewImpl$Action$ShowErrorsOnly">
      <add-to-group group-id="ProjectView.ToolWindow.Appearance.Actions" anchor="after" relative-to-action="ProjectView.ShowLibraryContents"/>
    </action>
    <action id="MPSProjectView.ShowDescriptorModels"
            class="jetbrains.mps.ide.projectView.ProjectViewImpl$Action$ShowDescriptorModels">
      <add-to-group group-id="ProjectView.ToolWindow.Appearance.Actions" anchor="after" relative-to-action="ProjectView.ShowLibraryContents"/>
    </action>
    <unregister id="ProjectView.SortByType"/>
    <action id="MPSProjectView.SortRootsByConcept"
            class="jetbrains.mps.ide.projectView.ProjectViewImpl$Action$SortRootsByConcept">
      <add-to-group group-id="ProjectView.ToolWindow.Sort.Actions" anchor="after" relative-to-action="ProjectView.SortByName"/>
    </action>
    <unregister id="ProjectView.FoldersAlwaysOnTop"/>
    <unregister id="ViewInplaceComments"/>
    <unregister id="ProjectView.CustomizeTrees"/>
  </actions>

</idea-plugin>
