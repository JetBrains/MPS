<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
  <actions>
    <group id="MPSToolbarRunGroup">
      <!--for integration purposes-->
      <add-to-group group-id="ToolbarRunGroup" relative-to-action="RunConfiguration" anchor="before"/>
    </group>

    <!--
      WelcomeScreen.CreateNewProject is not added to WelcomeScreen.QuickStart on purpose: the platform's
      WelcomeScreen.DefaultNewProjectActionGroup already looks this action up by id and puts it on the welcome
      screen. Adding it here as well makes the same action occupy two slots of the quick start toolbar, which
      pushes Vcs.VcsClone ("Clone Repository") out of the primary buttons into the "more actions" menu (MPS-39966).
    -->
    <group id="WelcomeScreen.QuickStart.MPS">
      <action id="WelcomeScreen.CreateNewProject"
              class="jetbrains.mps.workbench.actions.NewMPSProjectAction"
              text="New Project"
              description="You can create a new project with this action"/>
<!--      <action id="WelcomeScreen.OpenProject"-->
<!--              class="jetbrains.mps.workbench.actions.OpenMPSProjectAction$OnMPSWelcomeScreen"-->
<!--              text="Open"-->
<!--              description="You can open existing project with this action"/>-->
    </group>
  </actions>
</idea-plugin>
