<!--
  Content-module descriptor for jetbrains.mps.ide.customization (declared from MPSPlugin.template.xml).

  MPS-40020: ExternalProductResourceUrls decides where Help, What's New, the feedback forms and the download/patch
  links point. The platform declares it in its main descriptor (PlatformExtensions.xml), and MPSPlugin.template.xml
  overrides it with MPS's URLs. But MPS's product layout in intellij-community (MPSProperties.getProductContentDescriptor)
  also ships intellij.idea.customization.base, which overrides the same service with IDEA's URLs. Content modules are
  registered after the main descriptor, and the last override wins, so without this module MPS shows IDEA's pages.
  The dependency below puts this module after intellij.idea.customization.base, so MPS's override is applied last.

  The package prefix deliberately matches no classes. A content module without its own jar must declare one, and
  classes under it are loaded by this module's class loader. MPSExternalResourceUrls lives in
  jetbrains.mps.intellij.integration, so it stays on the core class loader, which the registration in
  MPSPlugin.template.xml needs. Do not put code into jetbrains.mps.ide.customization.

  Known wart: IDEA's registration is not open="true", so this override logs InstanceNotOverridableException at WARN.
  It is applied anyway, but the platform plans to stop tolerating such overrides.
-->
<idea-plugin package="jetbrains.mps.ide.customization">
  <dependencies>
    <module name="intellij.idea.customization.base"/>
  </dependencies>
  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceInterface="com.intellij.platform.ide.customization.ExternalProductResourceUrls"
                        serviceImplementation="jetbrains.mps.intellij.integration.MPSExternalResourceUrls"
                        overrides="true"/>
  </extensions>
</idea-plugin>
