<!--
  Content-module descriptor for jetbrains.mps.ide.whatsNew (declared from MPSPlugin.template.xml).
  MPS-39970: WhatsNewInVisionContentProvider is registered by intellij.platform.whatsNew after the main
  descriptor, so the override has to live here rather than in MPSPlugin.template.xml. The dependency below
  is what puts this module after it.

  The module has no jar of its own, so it must declare a package prefix; classes under jetbrains.mps.ide.whatsnew
  are loaded by this module's class loader. Keep anything registered from MPSPlugin.template.xml out of it.

  As of 2026.2 this module is excluded at runtime: intellij.platform.whatsNew needs JCEF, which MPS does
  not ship, so Help | What's New falls back to opening ExternalProductResourceUrls.whatIsNewPageUrl.
  To bring the in-IDE What's New page back, JCEF (intellij.platform.ui.jcef) has to be added to MPS's product
  layout in intellij-community (MPSProperties) - that is a separate decision, not tracked here.
-->
<idea-plugin package="jetbrains.mps.ide.whatsnew">
  <dependencies>
    <module name="intellij.platform.whatsNew"/>
  </dependencies>
  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceInterface="com.intellij.platform.whatsNew.WhatsNewInVisionContentProvider"
                        serviceImplementation="jetbrains.mps.ide.whatsnew.MPSWhatsNewInVisionContentProvider"
                        overrides="true"/>
  </extensions>
</idea-plugin>
